# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — local dev values come from `supabase start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App origin used in magic-link redirects (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map imagery — optional. With a token the Corners map uses satellite tiles;
# without it the drawn fallback renders.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Anthropic — optional. Enables the "Draft Spanish" helper on the Content tab.
ANTHROPIC_API_KEY=

# Sentry — optional. Without a DSN, Sentry is a no-op.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Phase 4+ (not used yet)
HIGGSFIELD_API_KEY=
N8N_WEBHOOK_SECRET=
MONDAY_API_TOKEN=
